{
    "name": "AiPaw",
    "version": "1.0.0",
    "description": "This extension generates a vpet and tracks your browsing content in real time to generate notes.",
    "manifest_version": 3,
    "permissions": ["scripting", "storage", "tabs", "sidePanel", "downloads", "activeTab"],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
    {
    "matches": ["<all_urls>"],
    "js": ["libs/Readability.js", "content.js"]
    }
  ],

    "web_accessible_resources": [
    {
      "resources": ["libs/tesseract.min.js", "libs/Readability.js"],
      "matches": ["<all_urls>"]
    }
  ],

    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],

    "side_panel": {
        "default_path": "index.html"
    }
}
